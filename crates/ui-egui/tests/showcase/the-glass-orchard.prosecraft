          },
          {
            "id": "w-delphine",
            "title": "Delphine Calder",
            "space": "Wiki",
            "folderId": "f-characters",
            "content": "<p>Master of the Saltmarsh glassworks, sixty-one. Blew the plum tree herself the year Ines was born.</p>",
            "meta": {
              "kind": "character",
              "aliases": [
                "Delphine",
                "Aunt Delphine"
              ],
              "sheetTemplate": "fantasy",
              "sheet": {
