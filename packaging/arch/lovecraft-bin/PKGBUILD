# Maintainer: LoveCraft contributors <https://github.com/jonasbove/LoveCraft>
#
# AUR recipe for the prebuilt release: downloads lovecraft-<ver>-linux-<arch>.tar.gz from the
# GitHub release and checks its SHA-256 and its GPG signature (.asc). See ../README.md for
# publishing it (updpkgsums, .SRCINFO). The files are named lovecraft-… from 0.2.0 on
# (prosecraft-rs-… before). Adapted from CraftCloud's packaging/arch/craftcloud-bin/PKGBUILD
# (MIT OR Apache-2.0; see NOTICE).
#
# LoveCraft was ProseCraft-rs until 0.2.0: this recipe replaces prosecraft-rs-bin, and the
# tarball keeps its commands (prosecraft-rs, prosecraft-mcp) as links.
pkgname=lovecraft-bin
pkgver=0.3.0
pkgrel=1
pkgdesc='Novel-writing app: outline, write and publish (a Rust rewrite of ProseCraft; prebuilt release)'
arch=('x86_64' 'aarch64')
url='https://github.com/jonasbove/LoveCraft'
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
  'libx11' 'libxcursor' 'libxi' 'libxrandr')
optdepends=(
  'xdg-desktop-portal: the Open and Save dialogs'
  'xdg-utils: opening web links and wiki files'
  'mesa: OpenGL drivers'
  'shared-mime-info: the .prosecraft file type'
)
provides=('lovecraft' 'prosecraft-rs')
conflicts=('lovecraft' 'lovecraft-git' 'prosecraft-rs' 'prosecraft-rs-bin' 'prosecraft-rs-git')
replaces=('prosecraft-rs-bin')
options=('!strip' '!debug')

_release="https://github.com/jonasbove/LoveCraft/releases/download/v${pkgver}"
source_x86_64=("${_release}/lovecraft-${pkgver}-linux-x86_64.tar.gz"{,.asc})
source_aarch64=("${_release}/lovecraft-${pkgver}-linux-aarch64.tar.gz"{,.asc})
# The release signing key ("ProseCraft-rs releases", named for LoveCraft's former name;
# release-signing-key.asc on every release and
# in the repository root); makepkg checks each tarball's .asc against it. This is the main key's
# fingerprint: the signatures are made with its signing subkey.
_fingerprint=29E57E45001D294F72E2EC80C42E3F3BDD6A7FF4
validpgpkeys=("${_fingerprint}")
# Written by updpkgsums for each release (the .asc files are checked by their signature).
sha256sums_x86_64=('a3ca5eaddbc58a22119024753f95a9c3952e5a7edc4c19f5495bf7d43726f6d9'
                   'SKIP')
sha256sums_aarch64=('6b37b65c2ce5e2a1bd0c94b5ab70b506cadc3d826b2e59e2b5888b18fc0b285f'
                    'SKIP')

package() {
  local dir="lovecraft-${pkgver}-linux-${CARCH}"
  install -Dm755 "${dir}/bin/lovecraft" "${pkgdir}/usr/bin/lovecraft"
  install -Dm755 "${dir}/bin/lovecraft-mcp" "${pkgdir}/usr/bin/lovecraft-mcp"
  ln -s lovecraft "${pkgdir}/usr/bin/prosecraft-rs"
  ln -s lovecraft-mcp "${pkgdir}/usr/bin/prosecraft-mcp"
  cp -dr --no-preserve=ownership "${dir}/share" "${pkgdir}/usr/"
  install -Dm644 "${dir}/share/doc/lovecraft/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "${dir}/share/doc/lovecraft/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
