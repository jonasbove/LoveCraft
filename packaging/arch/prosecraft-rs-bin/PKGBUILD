# Maintainer: ProseCraft-rs contributors <https://github.com/jonasbove/ProseCraft-rs>
#
# AUR recipe for the prebuilt release: downloads prosecraft-rs-<ver>-linux-<arch>.tar.gz from the
# GitHub release and checks its SHA-256 and its GPG signature (.asc). See ../README.md for
# publishing it (updpkgsums, .SRCINFO). The first release with these files is the one after
# 0.1.1. Adapted from CraftCloud's packaging/arch/craftcloud-bin/PKGBUILD (MIT OR Apache-2.0;
# see NOTICE).
pkgname=prosecraft-rs-bin
pkgver=0.1.1
pkgrel=1
pkgdesc='Novel-writing app: outline, write and publish (a Rust rewrite of ProseCraft; prebuilt release)'
arch=('x86_64' 'aarch64')
url='https://github.com/jonasbove/ProseCraft-rs'
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
  'libx11' 'libxcursor' 'libxi' 'libxrandr')
optdepends=(
  'xdg-desktop-portal: the Open and Save dialogs'
  'xdg-utils: opening web links and wiki files'
  'mesa: OpenGL drivers'
  'shared-mime-info: the .prosecraft file type'
)
provides=('prosecraft-rs')
conflicts=('prosecraft-rs' 'prosecraft-rs-git')
options=('!strip' '!debug')

_release="https://github.com/jonasbove/ProseCraft-rs/releases/download/v${pkgver}"
source_x86_64=("${_release}/prosecraft-rs-${pkgver}-linux-x86_64.tar.gz"{,.asc})
source_aarch64=("${_release}/prosecraft-rs-${pkgver}-linux-aarch64.tar.gz"{,.asc})
# The release signing key ("ProseCraft-rs releases", release-signing-key.asc on every release and
# in the repository root); makepkg checks each tarball's .asc against it. This is the main key's
# fingerprint: the signatures are made with its signing subkey.
_fingerprint=29E57E45001D294F72E2EC80C42E3F3BDD6A7FF4
validpgpkeys=("${_fingerprint}")
# Filled in by updpkgsums for each release (the .asc files are checked by their signature).
sha256sums_x86_64=('TODO' 'SKIP')
sha256sums_aarch64=('TODO' 'SKIP')

package() {
  local dir="prosecraft-rs-${pkgver}-linux-${CARCH}"
  install -Dm755 "${dir}/bin/prosecraft-rs" "${pkgdir}/usr/bin/prosecraft-rs"
  install -Dm755 "${dir}/bin/prosecraft-mcp" "${pkgdir}/usr/bin/prosecraft-mcp"
  cp -dr --no-preserve=ownership "${dir}/share" "${pkgdir}/usr/"
  install -Dm644 "${dir}/share/doc/prosecraft-rs/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "${dir}/share/doc/prosecraft-rs/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
