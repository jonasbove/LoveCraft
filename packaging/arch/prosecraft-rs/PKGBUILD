# Maintainer: ProseCraft-rs contributors <https://github.com/jonasbove/ProseCraft-rs>
#
# AUR recipe that builds ProseCraft-rs from the release's source tarball with cargo, with the
# interface and manuscript fonts from storytold/craft-fonts at the commit the release workflow
# uses (CRAFT_FONTS_REF in .github/workflows/release.yml). See ../README.md for publishing it
# (updpkgsums, .SRCINFO). Adapted from CraftCloud's packaging/arch/craftcloud/PKGBUILD
# (MIT OR Apache-2.0; see NOTICE).
pkgname=prosecraft-rs
pkgver=0.1.1
pkgrel=1
pkgdesc='Novel-writing app: outline, write and publish (a Rust rewrite of ProseCraft)'
arch=('x86_64' 'aarch64')
url='https://github.com/jonasbove/ProseCraft-rs'
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
  'libx11' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=(
  'xdg-desktop-portal: the Open and Save dialogs'
  'xdg-utils: opening web links and wiki files'
  'mesa: OpenGL drivers'
  'shared-mime-info: the .prosecraft file type'
)
provides=('prosecraft-rs')
conflicts=('prosecraft-rs-bin' 'prosecraft-rs-git')
options=('!lto')
_fonts=cc9269cd8d8258785dac603fba3122e5d2556795
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/jonasbove/ProseCraft-rs/archive/refs/tags/v${pkgver}.tar.gz"
  "craft-fonts::git+https://github.com/storytold/craft-fonts.git#commit=${_fonts}")
# Filled in by updpkgsums for each release (the git checkout is pinned by its commit).
sha256sums=('TODO' 'SKIP')

_id=io.github.jonasbove.prosecraft_rs
_src=ProseCraft-rs-${pkgver}

prepare() {
  cd "${_src}"
  export RUSTUP_TOOLCHAIN=stable
  # Cargo.lock pins git dependencies too; fetch them all here, so build() runs offline.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_src}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export CRAFT_FONTS_DIR="${srcdir}/craft-fonts" CRAFT_FONTS_REQUIRED=1
  cargo build --frozen --release -p prosecraft-rs -p prosecraft-mcp
}

check() {
  cd "${_src}"
  ./target/release/prosecraft-rs --version
}

package() {
  cd "${_src}"
  install -Dm755 target/release/prosecraft-rs "${pkgdir}/usr/bin/prosecraft-rs"
  install -Dm755 target/release/prosecraft-mcp "${pkgdir}/usr/bin/prosecraft-mcp"
  install -Dm644 "packaging/linux/${_id}.desktop" "${pkgdir}/usr/share/applications/${_id}.desktop"
  install -Dm644 "packaging/linux/${_id}.mime.xml" "${pkgdir}/usr/share/mime/packages/${_id}.xml"
  install -dm755 "${pkgdir}/usr/share/metainfo"
  sed -e "s/@VERSION@/${pkgver}/g" -e "s/@DATE@/$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y-%m-%d)/g" \
    "packaging/linux/${_id}.metainfo.xml.in" >"${pkgdir}/usr/share/metainfo/${_id}.metainfo.xml"
  install -dm755 "${pkgdir}/usr/share/icons"
  cp -dr --no-preserve=ownership packaging/linux/icons/hicolor "${pkgdir}/usr/share/icons/"
  install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.md NOTICE
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" LICENSE-MIT LICENSE-APACHE
}
